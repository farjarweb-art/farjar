// مجموعة فرجار (Farjar Group) — مخطط قاعدة البيانات
// PostgreSQL + Prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── التعدادات ───────────────────────────

enum UserRole {
  ADMIN // Super Admin: كل الصلاحيات
  STAFF // موظف إدارة (صلاحيات كاملة كما في الإصدارات السابقة)
  MANAGER // Delivery Manager: الطلبات والتوزيع والمتابعة والتحصيل
  DRIVER // Delivery Admin (موظف توصيل): الطلبات المسندة إليه فقط
}

/// حالة موحّدة للحجوزات والطلبات وطلبات الشركات
enum RequestStatus {
  NEW // جديد
  UNDER_REVIEW // قيد المراجعة
  PRICED // تم التسعير
  CONFIRMED // مؤكد
  IN_PROGRESS // قيد التنفيذ
  COMPLETED // مكتمل
  CANCELLED // ملغي
}

enum BookingType {
  INSPECTION // أعطال بناء / كشف عن الموقع
  PAINTING // أعمال دهان
  CONSTRUCTION // أعمال البناء
  METALWORK // أعمال معدنية
  GENERAL // خدمات عامة
}

enum Urgency {
  NORMAL // عادي
  URGENT // عاجل
  EMERGENCY // طارئ
}

enum AreaZone {
  INSIDE_AMMAN
  OUTSIDE_AMMAN
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum CorporateRequestType {
  ANNUAL // عقد صيانة سنوي
  URGENT // طلب صيانة عاجل
}

enum ProductionImpact {
  NO_STOP_NEEDED // يمكن العمل دون إيقاف الإنتاج
  CANNOT_STOP // لا يمكن إيقاف الإنتاج
  PARTIAL_STOP // يمكن الإيقاف جزئيًا
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
}

/// نوع العقد: صيانة عامة أو عقد سنوي لشركة
enum ContractType {
  MAINTENANCE
  ANNUAL_CORPORATE
}

enum RenewalStatus {
  NONE
  PENDING
  RENEWED
  NOT_RENEWING
}

enum ContractVisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  MISSED
}

enum TenderStatus {
  DRAFT
  OPEN
  CLOSED
  UNDER_REVIEW
  AWARDED
  CANCELLED
}

enum TenderOfferStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

/// حالة التوصيل (منفصلة عن حالة الطلب الموحّدة)
/// مسار الطلب: NEW → ACCEPTED → PICKUP_ASSIGNED → PICKED_UP → IN_TRANSIT → ARRIVED → DELIVERED → PAYMENT_COLLECTED → COMPLETED
enum DeliveryStatus {
  NEW
  ACCEPTED
  PICKUP_ASSIGNED
  PICKED_UP
  IN_TRANSIT
  ARRIVED
  DELIVERED
  PAYMENT_COLLECTED
  COMPLETED
  // حالات استثنائية
  DELIVERY_FAILED
  CUSTOMER_NOT_AVAILABLE
  CUSTOMER_REFUSED
  WRONG_ADDRESS
  RESCHEDULED
  CANCELLED
}

/// الحالة المالية للطلب (تُحسب من طريقة الدفع والمبلغ المطلوب والمحصّل)
enum FinancialStatus {
  PAID
  COD
  PARTIAL_PAYMENT
  PAYMENT_PENDING
  COLLECTED
  NOT_COLLECTED
}

/// مصدر الطلب
enum OrderSource {
  STORE // من المتجر (سلة العميل)
  SUPPLIER // أنشأه المورد
  ADMIN // أنشأته الإدارة
}

enum AssignmentStatus {
  ASSIGNED // بانتظار قبول الموظف
  ACCEPTED
  UNASSIGNED // أُعيد إسناده أو أُلغي الإسناد
}

enum NotificationRecipient {
  USER // موظفو الإدارة والتوصيل
  CUSTOMER
  VENDOR
}

enum DriverStatus {
  ACTIVE
  INACTIVE
}

/// تحصيل الدفع عند الاستلام
enum CodStatus {
  PENDING
  COLLECTED
  SETTLED
}

enum SettlementStatus {
  CONFIRMED
  VOIDED
}

enum QuoteFileKind {
  EVALUATION // تقييم
  QUOTE // عرض سعر
  CONTRACT // عقد
  INVOICE // فاتورة
  OTHER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CLIQ
  CARD
  OTHER
  COD
}

/// مراجعة منتجات الموردين قبل ظهورها في المتجر
enum ProductApproval {
  PENDING // بانتظار المراجعة
  APPROVED // معتمد
  REJECTED // مرفوض
}

enum WhatsAppChannel {
  LINK // رابط wa.me يفتحه المستخدم
  CLOUD_API // إرسال تلقائي عبر Meta Cloud API
}

enum WhatsAppStatus {
  PREPARED
  SENT
  FAILED
}

// ─────────────────────────── المستخدمون ───────────────────────────

/// حسابات لوحة التحكم (الأدمن والموظفون)
model User {
  id           String    @id @default(cuid())
  name         String
  /// اختياري لموظفي التوصيل (يدخلون باسم المستخدم)
  email        String?   @unique
  /// اسم المستخدم للدخول (أحرف إنجليزية صغيرة وأرقام) — يُخزَّن بأحرف صغيرة
  username     String?   @unique
  phone        String?
  passwordHash String
  role         UserRole  @default(ADMIN)
  /// الصلاحيات الفعلية للمستخدم (تبدأ من صلاحيات الدور ويعدّلها الـ Super Admin)
  permissions  String[]  @default([])
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  /// حذف ناعم: يبقى في السجلات ولا يدخل
  deletedAt    DateTime?

  auditLogs   AuditLog[]
  campaigns   EmailCampaign[]
  payments    Payment[]            @relation("PaymentRecordedBy")
  payouts     VendorPayout[]       @relation("PayoutRecordedBy")
  feePayments FarjarFeePayment[]   @relation("FeePaymentRecordedBy")
  settlements DeliverySettlement[] @relation("SettlementReceivedBy")
  quotes      QuoteFile[]          @relation("QuoteUploadedBy")

  driver          Driver?
  statusEvents    OrderStatusEvent[]
  assignmentsMade DeliveryAssignment[] @relation("AssignedBy")
  proofs          DeliveryProof[]      @relation("ProofBy")
  collectedOrders Order[]              @relation("CollectedBy")
  notifications   Notification[]

  @@index([role])
}

/// العملاء — يتم إنشاؤهم تلقائيًا عند أول حجز أو طلب برقم الهاتف، أو بالتسجيل من صفحة /register
model Customer {
  id              String    @id @default(cuid())
  phone           String    @unique
  name            String
  /// يُخزن بأحرف صغيرة — يُستخدم للدخول مع كلمة المرور
  email           String?   @unique
  companyName     String?
  passwordHash    String?
  otpHash         String?
  otpExpiresAt    DateTime?
  otpAttempts     Int       @default(0)
  notes           String?
  lastLoginAt     DateTime?
  /// وقت إنشاء الحساب بالتسجيل الذاتي (فارغ للعملاء المنشئين تلقائيًا من الحجز)
  registeredAt    DateTime?
  /// موافقة على استلام النشرة البريدية (منتجات وخدمات جديدة) — يمكن إلغاؤها من الحساب أو رابط البريد
  emailOptIn      Boolean   @default(true)
  /// تأكيد ملكية البريد برمز OTP
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  /// برنامج الولاء (مرحلة لاحقة): REGULAR → SILVER → GOLD → VIP
  loyaltyTier     String    @default("REGULAR")
  loyaltyPoints   Int       @default(0)

  bookings          Booking[]
  orders            Order[]
  tenders           Tender[]
  vendor            Vendor?
  corporateRequests CorporateRequest[]
  contracts         Contract[]
  quoteFiles        QuoteFile[]
  payments          Payment[]
  vendorMemberships VendorMember[]
  rfqs              Rfq[]
  reviews           SupplierReview[]
  recognitions      Recognition[]
  rewards           Reward[]
  coupons           Coupon[]
  couponRedemptions CouponRedemption[]
  pointsLedger      LoyaltyPointsLedger[]

  @@index([name])
  @@index([deletedAt])
}

/// الفنيون الذين يُعيَّنون على الحجوزات
model Technician {
  id        String          @id @default(cuid())
  name      String
  phone     String
  specialty String?
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  bookings  Booking[]
  contracts Contract[]
  visits    ContractVisit[]
}

// ─────────────────────────── المتجر ───────────────────────────

/// أقسام السوق (ديناميكية من لوحة التحكم) — مستويان: قسم رئيسي وأقسام فرعية
model Category {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  /// القسم الرئيسي (فارغ للأقسام الرئيسية)
  parentId   String?
  /// حقول المواصفات لمنتجات هذا القسم: [{ key, label, type: text|number|select, options?, required? }]
  specFields Json      @default("[]")
  sortOrder  Int       @default(0)
  visible    Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  /// مجموعة العمولة الافتراضية للقسم (قطع غيار، معدات…) — تُستخدم في قواعد العمولات
  commissionGroup    String?
  /// وصف قصير يظهر في صفحة السوق
  description        String?
  /// نسبة فرجار الافتراضية لمنتجات هذا القسم (فارغ = الافتراضي العام). تُطبّق عند إنشاء المنتج
  platformFeePercent Decimal? @db.Decimal(5, 2)

  parent          Category?        @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[]       @relation("CategoryTree")
  products        Product[]
  rfqs            Rfq[]
  commissionRules CommissionRule[]

  @@index([parentId])
}

/// المورد (متجر داخل السوق). المورد الافتراضي (isHouse) هو الشركة نفسها وليس له حساب عميل
model Vendor {
  id                        String       @id @default(cuid())
  /// حساب العميل صاحب المتجر (فارغ للمورد الافتراضي)
  customerId                String?      @unique
  name                      String
  slug                      String       @unique
  description               String       @default("")
  logoUrl                   String?
  logoPublicId              String?
  /// نسبة عمولة المنصة من كل بيع (0–100) — نظام قديم، حلّت محله نسبة فرجار لكل منتج
  commissionPercent         Decimal      @default(10) @db.Decimal(5, 2)
  /// نسبة فرجار الافتراضية لمنتجات هذا المورد (فارغ = حسب القسم أو الافتراضي العام). تُطبّق عند إنشاء المنتج
  platformFeePercent        Decimal?     @db.Decimal(5, 2)
  /// سحب صلاحية المورد: لا يدخل اللوحة ولا تظهر منتجاته
  active                    Boolean      @default(true)
  isHouse                   Boolean      @default(false)
  /// عنوان الاستلام الافتراضي لطلبات التوصيل
  phone                     String?
  pickupAddress             String?
  pickupLat                 Float?
  pickupLng                 Float?
  // ── السوق الصناعي (B2B) ──
  /// حالة المورد في السوق: بانتظار المراجعة، معتمد، مرفوض، معلّق
  status                    VendorStatus @default(APPROVED)
  rejectionReason           String?
  /// علامة "مورد موثّق" تمنحها الإدارة بعد التحقق
  verified                  Boolean      @default(false)
  verifiedAt                DateTime?
  contactName               String?
  whatsapp                  String?
  email                     String?
  address                   String?
  city                      String?
  /// مجال العمل ونوع المنتجات (نص حر يظهر في صفحة المورد ويُبحث فيه)
  businessField             String?
  productTypes              String?
  licenseNumber             String?
  /// الكتالوج والشهادات: [{ url, name, kind }]
  catalogFiles              Json         @default("[]")
  certificates              Json         @default("[]")
  /// التصنيفات التي يخدمها (لاقتراحه في طلبات عروض الأسعار)
  categoryIds               String[]     @default([])
  // ── الاشتراك الحالي ──
  planId                    String?
  planStartedAt             DateTime?
  planExpiresAt             DateTime?
  /// شارة التميز الظاهرة للعامة (مثل "مورد الشهر") حتى تاريخ محدد — تُمنح كمكافأة من الـ Super Admin
  awardTitle                String?
  awardUntil                DateTime?
  /// مكافأة: منتجات إضافية فوق حد الباقة حتى تاريخ محدد
  extraProducts             Int          @default(0)
  extraProductsUntil        DateTime?
  /// مكافأة: نسبة خصم على طلبات الاشتراك حتى تاريخ محدد
  subscriptionDiscountPct   Int          @default(0)
  subscriptionDiscountUntil DateTime?
  /// برنامج الولاء (مرحلة لاحقة): STANDARD → VERIFIED → PREMIUM → FEATURED
  loyaltyTier               String       @default("STANDARD")
  loyaltyPoints             Int          @default(0)
  /// عدّاد زيارات صفحة المورد
  profileViews              Int          @default(0)
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  customer      Customer?             @relation(fields: [customerId], references: [id])
  plan          SupplierPlan?         @relation(fields: [planId], references: [id])
  members       VendorMember[]
  subscriptions VendorSubscription[]
  rfqRecipients RfqRecipient[]
  quotes        Quote[]
  conversations Conversation[]
  ads           MarketAd[]
  invoices      MarketInvoice[]
  reviews       SupplierReview[]
  directRfqs    Rfq[]                 @relation("RfqDirectVendor")
  dailyStats    VendorDailyStat[]
  products      Product[]
  vendorOrders  VendorOrder[]
  orderItems    OrderItem[]
  payouts       VendorPayout[]
  feePayments   FarjarFeePayment[]
  tenderOffers  TenderOffer[]
  orders        Order[]               @relation("OrderSupplier")
  recognitions  Recognition[]
  rewards       Reward[]
  pointsLedger  LoyaltyPointsLedger[]

  @@index([active])
  @@index([status])
  @@index([verified])
}

model Product {
  id                 String          @id @default(cuid())
  name               String
  slug               String          @unique
  description        String
  /// سعر المورد قبل نسبة فرجار — يدخله المورد
  supplierPrice      Decimal         @default(0) @db.Decimal(10, 3)
  /// نسبة فرجار لهذا المنتج (تحددها الإدارة، الافتراضي 2%)
  platformFeePercent Decimal         @default(2) @db.Decimal(5, 2)
  /// طلب المورد تغيير النسبة (عند السماح بذلك في الإعدادات)
  feeRequestPercent  Decimal?        @db.Decimal(5, 2)
  feeRequestNote     String?
  feeRequestAt       DateTime?
  /// سعر العميل الأصلي بالدينار = سعر المورد × (1 + نسبة فرجار) — يُحسب في الخادم فقط (3 خانات عشرية = فلس)
  price              Decimal         @db.Decimal(10, 3)
  /// نسبة الخصم 0–90
  discountPercent    Int             @default(0)
  /// السعر النهائي بعد الخصم — يُحسب تلقائيًا عند الحفظ
  finalPrice         Decimal         @db.Decimal(10, 3)
  stock              Int             @default(0)
  visible            Boolean         @default(true)
  featured           Boolean         @default(false)
  categoryId         String
  vendorId           String
  /// منتجات الموردين تظهر بعد موافقة الإدارة
  approvalStatus     ProductApproval @default(PENDING)
  rejectionReason    String?
  /// المواصفات حسب حقول القسم، مثل { "size": "L", "color": "أسود" }
  specs              Json            @default("{}")
  /// خيارات يختارها العميل عند الشراء: [{ name: "اللون", values: [{ label: "أحمر", mediaId?: "صورة هذا اللون" }] }]
  options            Json            @default("[]")
  // ── بيانات صناعية (B2B) ──
  sku                String?
  /// رقم القطعة لدى الشركة المصنعة
  partNumber         String?
  manufacturer       String?
  brand              String?
  originCountry      String?
  /// السعر عند الطلب: لا يظهر السعر ويُطلب عرض سعر
  priceOnRequest     Boolean         @default(false)
  minOrderQty        Int             @default(1)
  availability       Availability    @default(IN_STOCK)
  /// مدة التوريد بالأيام (تقريبية)
  leadTimeDays       Int?
  warranty           String?
  videoUrl           String?
  /// كلمات مفتاحية للبحث (مفصولة بفواصل)
  keywords           String?
  /// الملفات الفنية والكتالوج: [{ url, name, kind }]
  documents          Json            @default("[]")
  views              Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  category   Category       @relation(fields: [categoryId], references: [id])
  vendor     Vendor         @relation(fields: [vendorId], references: [id])
  media      ProductMedia[]
  orderItems OrderItem[]
  rfqs       Rfq[]
  ads        MarketAd[]

  @@index([categoryId])
  @@index([vendorId])
  @@index([approvalStatus])
  @@index([visible, deletedAt])
  @@index([featured])
  @@index([brand])
  @@index([sku])
}

model ProductMedia {
  id        String    @id @default(cuid())
  productId String
  kind      MediaKind @default(IMAGE)
  url       String
  publicId  String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id                String           @id @default(cuid())
  /// رقم الطلب المعروض (#1042)
  number            Int              @unique @default(autoincrement())
  /// رمز مرجعي عشوائي يستخدمه العميل للدخول لحسابه
  ref               String           @unique
  /// رقم الطلب الموحّد FG-ORD-000001
  code              String?          @unique
  source            OrderSource      @default(STORE)
  /// المورد صاحب طلب التوصيل (طلبات المورد/الإدارة)؛ طلبات المتجر مرتبطة بالموردين عبر الطلبات الفرعية
  supplierId        String?
  customerId        String
  customerName      String
  phone             String
  /// عنوان التسليم
  address           String
  deliveryLat       Float?
  deliveryLng       Float?
  /// منطقة التوصيل (للتصفية والتوزيع)
  area              String?
  pickupAddress     String?
  pickupLat         Float?
  pickupLng         Float?
  pickupPhone       String?
  notes             String?
  status            RequestStatus    @default(NEW)
  subtotal          Decimal          @db.Decimal(10, 3)
  discountTotal     Decimal          @db.Decimal(10, 3)
  total             Decimal          @db.Decimal(10, 3)
  /// خصم الكوبون (تتحمله FARJAR — لا يغيّر مستحقات الموردين)
  couponId          String?
  couponCode        String?
  couponDiscount    Decimal          @default(0) @db.Decimal(10, 3)
  whatsappText      String
  /// طريقة الدفع التي اختارها العميل (فارغة للطلبات القديمة)
  paymentMethod     PaymentMethod?
  // ── التوصيل ──
  deliveryStatus    DeliveryStatus   @default(NEW)
  driverId          String?
  deliveryCompanyId String?
  deliveryFee       Decimal          @default(0) @db.Decimal(10, 3)
  deliveredAt       DateTime?
  deliveryNote      String?
  acceptedAt        DateTime?
  pickedUpAt        DateTime?
  arrivedAt         DateTime?
  completedAt       DateTime?
  /// العميل يدفع أجرة التوصيل (تُضاف للمبلغ المطلوب تحصيله)
  customerPaysFee   Boolean          @default(true)
  financialStatus   FinancialStatus?
  // ── التحصيل ── codAmount = المبلغ المطلوب تحصيله من العميل (المنتجات حسب طريقة الدفع + أجرة التوصيل)
  codAmount         Decimal?         @db.Decimal(10, 3)
  codStatus         CodStatus?
  codCollected      Decimal?         @db.Decimal(10, 3)
  codCollectedAt    DateTime?
  collectedById     String?
  collectedMethod   PaymentMethod?
  /// رمز التحقق عند التسليم (OTP) — مشفّر
  otpHash           String?
  otpExpiresAt      DateTime?
  otpAttempts       Int              @default(0)
  settlementId      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  customer         Customer             @relation(fields: [customerId], references: [id])
  driver           Driver?              @relation(fields: [driverId], references: [id])
  deliveryCompany  DeliveryCompany?     @relation(fields: [deliveryCompanyId], references: [id])
  settlement       DeliverySettlement?  @relation(fields: [settlementId], references: [id])
  supplier         Vendor?              @relation("OrderSupplier", fields: [supplierId], references: [id])
  collectedBy      User?                @relation("CollectedBy", fields: [collectedById], references: [id])
  statusEvents     OrderStatusEvent[]
  assignments      DeliveryAssignment[]
  proof            DeliveryProof?
  notifications    Notification[]
  items            OrderItem[]
  vendorOrders     VendorOrder[]
  payments         Payment[]
  quoteFiles       QuoteFile[]
  coupon           Coupon?              @relation(fields: [couponId], references: [id])
  couponRedemption CouponRedemption?

  @@index([phone])
  @@index([status])
  @@index([createdAt])
  @@index([customerId])
  @@index([deliveryStatus])
  @@index([driverId])
  @@index([codStatus])
  @@index([supplierId])
  @@index([area])
  @@index([financialStatus])
}

/// طلب فرعي لكل مورد داخل طلب العميل — المورد يتابع حالته
model VendorOrder {
  id              String        @id @default(cuid())
  number          Int           @unique @default(autoincrement())
  orderId         String
  vendorId        String
  status          RequestStatus @default(NEW)
  subtotal        Decimal       @db.Decimal(10, 3)
  total           Decimal       @db.Decimal(10, 3)
  commissionTotal Decimal       @db.Decimal(10, 3)
  vendorNet       Decimal       @db.Decimal(10, 3)
  /// التسوية التي دُفع فيها صافي المورد (فرجار حصّلت المبلغ واحتفظت بنسبتها)
  payoutId        String?
  /// ما سدده المورد لفرجار من نسبة هذا الطلب (دفعات يدوية يسجلها الأدمن)
  feePaid         Decimal       @default(0) @db.Decimal(10, 3)
  /// اعتراض/نزاع على نسبة فرجار لهذا الطلب
  feeDisputed     Boolean       @default(false)
  feeDisputeNote  String?
  feeDisputedAt   DateTime?
  /// من فتح النزاع: SUPPLIER أو ADMIN
  feeDisputedBy   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order          Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor         Vendor                @relation(fields: [vendorId], references: [id])
  payout         VendorPayout?         @relation(fields: [payoutId], references: [id])
  items          OrderItem[]
  feeAllocations FarjarFeeAllocation[]

  @@unique([orderId, vendorId])
  @@index([vendorId, status])
  @@index([payoutId])
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  vendorOrderId      String
  vendorId           String
  /// فارغ لبنود طلبات التوصيل التي يكتبها المورد (بدون منتج من المتجر)
  productId          String?
  /// نسخة من اسم المنتج وقت الطلب
  name               String
  /// الخيار الذي اختاره العميل: [{ name: "اللون", value: "أحمر" }]
  options            Json?
  /// نص الخيار للعرض: "اللون: أحمر · المقاس: L"
  variant            String?
  unitPrice          Decimal  @db.Decimal(10, 3)
  discountPercent    Int      @default(0)
  unitFinalPrice     Decimal  @db.Decimal(10, 3)
  quantity           Int
  lineTotal          Decimal  @db.Decimal(10, 3)
  /// نسبة العمولة وقت البيع والمبالغ المحسوبة منها — تُحفظ ولا يُعاد حسابها
  commissionPercent  Decimal  @db.Decimal(5, 2)
  commissionAmount   Decimal  @db.Decimal(10, 3)
  vendorNet          Decimal  @db.Decimal(10, 3)
  /// لقطة نسبة فرجار وقت الطلب: سعر المورد للوحدة بعد الخصم، النسبة، ومبلغ فرجار للبند كاملًا — لا تتغير بتغيير نسبة المنتج لاحقًا
  supplierUnitPrice  Decimal? @db.Decimal(10, 3)
  platformFeePercent Decimal? @db.Decimal(5, 2)
  platformFeeAmount  Decimal? @db.Decimal(10, 3)

  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  vendor      Vendor      @relation(fields: [vendorId], references: [id])
  product     Product?    @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([vendorOrderId])
  @@index([vendorId])
}

/// تسوية: دفع المستحق للمورد عن طلبات فرعية مكتملة
model VendorPayout {
  id              String        @id @default(cuid())
  vendorId        String
  /// صافي المورد المدفوع
  amount          Decimal       @db.Decimal(12, 3)
  salesTotal      Decimal       @db.Decimal(12, 3)
  commissionTotal Decimal       @db.Decimal(12, 3)
  ordersCount     Int
  method          PaymentMethod @default(BANK_TRANSFER)
  reference       String?
  note            String?
  recordedById    String?
  paidAt          DateTime      @default(now())
  createdAt       DateTime      @default(now())

  vendor       Vendor        @relation(fields: [vendorId], references: [id])
  recordedBy   User?         @relation("PayoutRecordedBy", fields: [recordedById], references: [id])
  vendorOrders VendorOrder[]

  @@index([vendorId])
  @@index([paidAt])
}

// ─────────────────────────── الحجوزات ───────────────────────────

model Booking {
  id               String        @id @default(cuid())
  number           Int           @unique @default(autoincrement())
  ref              String        @unique
  type             BookingType
  status           RequestStatus @default(NEW)
  customerId       String
  // الحقول المشتركة (أعمدة مفهرسة)
  name             String
  phone            String
  locationText     String
  lat              Float?
  lng              Float?
  floor            String?
  scheduledAt      DateTime
  notes            String?
  urgency          Urgency       @default(NORMAL)
  zone             AreaZone?
  /// رسوم الكشف المحسوبة وقت الحجز (لحجوزات الكشف)
  inspectionFee    Decimal?      @db.Decimal(10, 3)
  /// المبلغ الذي يسعّره الأدمن للعمل
  quotedAmount     Decimal?      @db.Decimal(10, 3)
  /// الحقول الخاصة بكل نوع
  details          Json          @default("{}")
  technicianId     String?
  adminNotes       String?
  whatsappText     String
  /// وقت موافقة العميل على سياسة الحجز
  policyAcceptedAt DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  customer   Customer       @relation(fields: [customerId], references: [id])
  technician Technician?    @relation(fields: [technicianId], references: [id])
  media      BookingMedia[]
  quoteFiles QuoteFile[]
  payments   Payment[]

  @@index([phone])
  @@index([status])
  @@index([scheduledAt])
  @@index([type])
  @@index([customerId])
  @@index([createdAt])
}

model BookingMedia {
  id           String    @id @default(cuid())
  bookingId    String
  kind         MediaKind @default(IMAGE)
  /// photo | design
  purpose      String    @default("photo")
  url          String
  publicId     String?
  originalName String?
  createdAt    DateTime  @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// ─────────────────────────── الشركات ───────────────────────────

/// كتالوج خدمات الشركات (سنوي / عاجل)
model CorporateService {
  id        String               @id @default(cuid())
  key       String               @unique
  name      String
  kind      CorporateRequestType
  sortOrder Int                  @default(0)
  active    Boolean              @default(true)

  requests  CorporateRequest[]
  contracts Contract[]         @relation("ContractServices")
  tenders   Tender[]
}

model CorporateRequest {
  id                     String               @id @default(cuid())
  number                 Int                  @unique @default(autoincrement())
  ref                    String               @unique
  type                   CorporateRequestType
  status                 RequestStatus        @default(NEW)
  customerId             String
  companyName            String
  contactName            String
  managerPhone           String
  maintenancePhone       String
  locationText           String
  lat                    Float?
  lng                    Float?
  commercialRegisterUrl  String?
  licenseUrl             String?
  // خاصة بالطلب العاجل
  workLocation           String?
  productionImpact       ProductionImpact?
  productionLineAffected Boolean?
  urgencyLevel           UrgencyLevel?
  notes                  String?
  adminNotes             String?
  quotedAmount           Decimal?             @db.Decimal(10, 3)
  /// العقد الذي يُنفَّذ هذا الطلب ضمنه (طلبات الصيانة ضمن عقد)
  contractId             String?
  whatsappText           String
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  deletedAt              DateTime?

  customer   Customer           @relation(fields: [customerId], references: [id])
  services   CorporateService[]
  contracts  Contract[]
  contract   Contract?          @relation("ContractRequests", fields: [contractId], references: [id])
  quoteFiles QuoteFile[]

  @@index([status])
  @@index([managerPhone])
  @@index([createdAt])
  @@index([customerId])
}

model Contract {
  id                 String         @id @default(cuid())
  number             Int            @unique @default(autoincrement())
  corporateRequestId String?
  customerId         String
  title              String
  startDate          DateTime
  endDate            DateTime
  value              Decimal        @db.Decimal(12, 3)
  status             ContractStatus @default(ACTIVE)
  fileUrl            String?
  reminderDays       Int            @default(30)
  reminderSentAt     DateTime?
  notes              String?
  /// مرجع متسلسل مثل MC-2026-00001 (العقود القديمة تبقى برقمها)
  ref                String?        @unique
  type               ContractType   @default(MAINTENANCE)
  paymentMethod      PaymentMethod?
  /// عدد الزيارات المشمولة
  visitsIncluded     Int?
  /// زمن الاستجابة المتفق عليه (بالساعات)
  responseHours      Int?
  technicianId       String?
  terms              String?
  renewalStatus      RenewalStatus  @default(NONE)
  tenderId           String?        @unique
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  corporateRequest CorporateRequest?  @relation(fields: [corporateRequestId], references: [id])
  customer         Customer           @relation(fields: [customerId], references: [id])
  technician       Technician?        @relation(fields: [technicianId], references: [id])
  tender           Tender?            @relation(fields: [tenderId], references: [id])
  services         CorporateService[] @relation("ContractServices")
  visits           ContractVisit[]
  requests         CorporateRequest[] @relation("ContractRequests")
  payments         Payment[]
  quoteFiles       QuoteFile[]

  @@index([endDate])
  @@index([status])
  @@index([customerId])
  @@index([type])
}

/// زيارة خدمة ضمن عقد
model ContractVisit {
  id           String              @id @default(cuid())
  contractId   String
  scheduledAt  DateTime
  technicianId String?
  status       ContractVisitStatus @default(SCHEDULED)
  notes        String?
  completedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  contract   Contract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  technician Technician? @relation(fields: [technicianId], references: [id])

  @@index([contractId])
  @@index([scheduledAt])
}

// ─────────────────────────── العطاءات ───────────────────────────

/// عطاء تنشره شركة (عميل) لخدمة صيانة
model Tender {
  id                String       @id @default(cuid())
  /// TEN-2026-00001
  ref               String       @unique
  customerId        String
  title             String
  description       String
  serviceId         String?
  location          String
  durationMonths    Int?
  deadline          DateTime
  budget            Decimal?     @db.Decimal(12, 3)
  requirements      String?
  attachments       Json         @default("[]")
  status            TenderStatus @default(DRAFT)
  // ── الترسية والعمولة (تُحفظ وقت الترسية) ──
  awardedOfferId    String?      @unique
  awardedAmount     Decimal?     @db.Decimal(12, 3)
  commissionPercent Decimal?     @db.Decimal(5, 2)
  commissionAmount  Decimal?     @db.Decimal(12, 3)
  providerAmount    Decimal?     @db.Decimal(12, 3)
  awardedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  customer     Customer          @relation(fields: [customerId], references: [id])
  service      CorporateService? @relation(fields: [serviceId], references: [id])
  offers       TenderOffer[]     @relation("TenderOffers")
  awardedOffer TenderOffer?      @relation("AwardedOffer", fields: [awardedOfferId], references: [id])
  contract     Contract?

  @@index([status])
  @@index([deadline])
  @@index([customerId])
}

/// عرض على عطاء: من المنصة نفسها (vendorId فارغ) أو من مورد/شركة
model TenderOffer {
  id           String            @id @default(cuid())
  tenderId     String
  vendorId     String?
  providerName String
  price        Decimal           @db.Decimal(12, 3)
  proposal     String
  attachments  Json              @default("[]")
  status       TenderOfferStatus @default(SUBMITTED)
  submittedAt  DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  tender    Tender  @relation("TenderOffers", fields: [tenderId], references: [id], onDelete: Cascade)
  vendor    Vendor? @relation(fields: [vendorId], references: [id])
  awardedOf Tender? @relation("AwardedOffer")

  @@index([tenderId])
  @@index([vendorId])
}

// ─────────────────────────── التوصيل ───────────────────────────

model DeliveryCompany {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  /// رسوم التوصيل الافتراضية لكل طلب
  defaultFee  Decimal  @default(0) @db.Decimal(10, 3)
  active      Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]
  settlements DeliverySettlement[]
}

/// سائق التوصيل الداخلي
model Driver {
  id        String       @id @default(cuid())
  name      String
  phone     String
  status    DriverStatus @default(ACTIVE)
  notes     String?
  /// حساب الدخول (موظف توصيل) — فارغ للسائقين المسجّلين بدون حساب
  userId    String?      @unique
  /// مناطق العمل (للتوزيع التلقائي لاحقًا)، مفصولة بفواصل
  areas     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user        User?                @relation(fields: [userId], references: [id])
  orders      Order[]
  settlements DeliverySettlement[]
  assignments DeliveryAssignment[]
}

/// تسليم النقد المحصّل (من سائق أو شركة توصيل) للشركة — لا يُحذف، يُلغى فقط
model DeliverySettlement {
  id                String           @id @default(cuid())
  /// SET-2026-00001
  ref               String           @unique
  driverId          String?
  deliveryCompanyId String?
  amount            Decimal          @db.Decimal(12, 3)
  ordersCount       Int
  status            SettlementStatus @default(CONFIRMED)
  notes             String?
  receivedById      String?
  receivedAt        DateTime         @default(now())
  voidedAt          DateTime?
  voidReason        String?
  createdAt         DateTime         @default(now())

  driver          Driver?          @relation(fields: [driverId], references: [id])
  deliveryCompany DeliveryCompany? @relation(fields: [deliveryCompanyId], references: [id])
  receivedBy      User?            @relation("SettlementReceivedBy", fields: [receivedById], references: [id])
  orders          Order[]

  @@index([driverId])
  @@index([deliveryCompanyId])
  @@index([receivedAt])
}

/// عدّاد المراجع المتسلسلة لكل بادئة وسنة (MC-2026، TEN-2026، SET-2026)
model RefCounter {
  key   String @id
  value Int    @default(0)
}

// ─────────────────────────── الملفات والمالية ───────────────────────────

/// ملفات التقييم وعروض الأسعار والعقود التي يرفعها الأدمن للعميل
model QuoteFile {
  id                 String        @id @default(cuid())
  customerId         String
  bookingId          String?
  orderId            String?
  corporateRequestId String?
  contractId         String?
  kind               QuoteFileKind @default(QUOTE)
  title              String
  url                String
  publicId           String?
  amount             Decimal?      @db.Decimal(12, 3)
  uploadedById       String?
  createdAt          DateTime      @default(now())
  deletedAt          DateTime?

  customer         Customer          @relation(fields: [customerId], references: [id])
  booking          Booking?          @relation(fields: [bookingId], references: [id])
  order            Order?            @relation(fields: [orderId], references: [id])
  corporateRequest CorporateRequest? @relation(fields: [corporateRequestId], references: [id])
  contract         Contract?         @relation(fields: [contractId], references: [id])
  uploadedBy       User?             @relation("QuoteUploadedBy", fields: [uploadedById], references: [id])

  @@index([customerId])
  @@index([createdAt])
}

model Payment {
  id           String        @id @default(cuid())
  customerId   String
  bookingId    String?
  orderId      String?
  contractId   String?
  amount       Decimal       @db.Decimal(12, 3)
  method       PaymentMethod @default(CASH)
  paidAt       DateTime      @default(now())
  reference    String?
  note         String?
  recordedById String?
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?

  customer   Customer  @relation(fields: [customerId], references: [id])
  booking    Booking?  @relation(fields: [bookingId], references: [id])
  order      Order?    @relation(fields: [orderId], references: [id])
  contract   Contract? @relation(fields: [contractId], references: [id])
  recordedBy User?     @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([customerId])
  @@index([paidAt])
}

// ─────────────────────────── النظام ───────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model WhatsAppLog {
  id         String          @id @default(cuid())
  to         String
  channel    WhatsAppChannel
  status     WhatsAppStatus
  message    String
  link       String?
  error      String?
  entityType String?
  entityId   String?
  createdAt  DateTime        @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  /// admin | customer | system | public
  actorType String
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

/// نشرة بريدية موحّدة لكل العملاء المسجّلين (منتج جديد، خدمة جديدة، إعلان)
model EmailCampaign {
  id          String    @id @default(cuid())
  subject     String
  body        String
  /// زر في الرسالة: none | product | bookings | corporate | store
  ctaKind     String    @default("none")
  productId   String?
  /// SENDING | DONE | FAILED
  status      String    @default("SENDING")
  recipients  Int       @default(0)
  sent        Int       @default(0)
  failed      Int       @default(0)
  lastError   String?
  createdById String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  createdBy User? @relation(fields: [createdById], references: [id])

  @@index([createdAt])
}

/// قفل تسجيل الدخول بعد محاولات خاطئة متكررة (لكل هاتف/بريد، حتى لو لم يكن الحساب موجودًا)
model LoginLock {
  /// المعرّف الموحّد: بريد بأحرف صغيرة أو رقم هاتف بالصيغة الدولية
  key         String    @id
  /// المحاولات الخاطئة منذ آخر قفل/نجاح
  failures    Int       @default(0)
  /// عدد مرات القفل المتتالية (كل مرة تتضاعف المدة)
  level       Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

/// إسناد الطلب لموظف توصيل (سجل كامل لكل إسناد وإعادة إسناد)
model DeliveryAssignment {
  id           String           @id @default(cuid())
  orderId      String
  driverId     String
  assignedById String?
  status       AssignmentStatus @default(ASSIGNED)
  assignedAt   DateTime         @default(now())
  acceptedAt   DateTime?
  endedAt      DateTime?
  note         String?

  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver     Driver @relation(fields: [driverId], references: [id])
  assignedBy User?  @relation("AssignedBy", fields: [assignedById], references: [id])

  @@index([orderId])
  @@index([driverId, status])
}

/// سجل تغيّر حالة الطلب (Activity Log)
model OrderStatusEvent {
  id         String          @id @default(cuid())
  orderId    String
  fromStatus DeliveryStatus?
  toStatus   DeliveryStatus
  /// المستخدم (إدارة/توصيل)، أو فارغ للعميل/المورد/النظام
  actorId    String?
  /// user | vendor | customer | system
  actorType  String
  actorName  String?
  note       String?
  lat        Float?
  lng        Float?
  createdAt  DateTime        @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])

  @@index([orderId, createdAt])
  @@index([actorId])
  @@index([createdAt])
}

/// إثبات التسليم — لا يُعدَّل إلا بصلاحية proofs.edit
model DeliveryProof {
  id              String    @id @default(cuid())
  orderId         String    @unique
  deliveredAt     DateTime  @default(now())
  lat             Float?
  lng             Float?
  accuracy        Float?
  recipientName   String
  signatureUrl    String?
  photoUrl        String?
  otpVerified     Boolean   @default(false)
  amountCollected Decimal?  @db.Decimal(10, 3)
  note            String?
  createdById     String?
  editedAt        DateTime?
  createdAt       DateTime  @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy User? @relation("ProofBy", fields: [createdById], references: [id])
}

/// الإشعارات داخل النظام (قابلة لإضافة قنوات: واتساب، SMS، بريد)
model Notification {
  id            String                @id @default(cuid())
  recipientType NotificationRecipient
  /// userId أو customerId أو vendorId حسب النوع
  recipientId   String
  userId        String?
  title         String
  body          String
  orderId       String?
  /// رابط داخل الموقع يفتحه الإشعار (مثل /account/rfq/…)
  link          String?
  /// in_app | whatsapp | sms | email
  channel       String                @default("in_app")
  readAt        DateTime?
  createdAt     DateTime              @default(now())

  user  User?  @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([recipientType, recipientId, readAt])
  @@index([createdAt])
}

/// الغرض من رمز التحقق المرسل بالبريد
enum OtpPurpose {
  LOGIN_2FA
  VERIFY_EMAIL
  PASSWORD_RESET
  SENSITIVE_ACTION
}

/// رموز التحقق بالبريد (OTP): يُخزن هاش الرمز فقط، صالح لمدة قصيرة ولمرة واحدة
model EmailOtp {
  id          String     @id @default(cuid())
  purpose     OtpPurpose
  /// customer | user
  subjectType String
  subjectId   String
  email       String
  codeHash    String
  expiresAt   DateTime
  attempts    Int        @default(0)
  consumedAt  DateTime?
  ip          String?
  createdAt   DateTime   @default(now())

  @@index([subjectType, subjectId, purpose, createdAt])
  @@index([expiresAt])
}

// ═════════════════ السوق الصناعي (B2B Industrial Marketplace) ═════════════════

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum Availability {
  IN_STOCK
  ON_ORDER
  OUT_OF_STOCK
}

enum VendorMemberRole {
  OWNER
  STAFF
}

/// باقات الموردين (Free / PRO / BUSINESS …) — كل الأسعار والحدود من لوحة الإدارة
model SupplierPlan {
  id             String   @id @default(cuid())
  /// FREE | PRO | BUSINESS (أو أي رمز جديد)
  code           String   @unique
  name           String
  description    String   @default("")
  price          Decimal  @default(0) @db.Decimal(10, 3)
  /// مدة الاشتراك بالأيام
  durationDays   Int      @default(30)
  /// null = غير محدود
  maxProducts    Int?
  maxUsers       Int      @default(1)
  /// طلبات عروض الأسعار شهريًا (null = غير محدود)
  maxRfqPerMonth Int?
  /// وزن الترتيب في نتائج البحث (أعلى = أولًا)
  searchBoost    Int      @default(0)
  /// أولوية الاقتراح في توزيع طلبات عروض الأسعار
  rfqPriority    Int      @default(0)
  /// الـ Leads مشمولة بالاشتراك (بدون رسوم لكل Lead)
  leadsIncluded  Boolean  @default(false)
  /// مزايا: { analytics, advancedReports, catalog, specialOffers, featuredBadge, campaigns }
  features       Json     @default("{}")
  badge          String?
  isDefault      Boolean  @default(false)
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vendors       Vendor[]
  subscriptions VendorSubscription[]
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
}

/// سجل اشتراكات المورد (التجديد والترقية والفواتير)
model VendorSubscription {
  id        String             @id @default(cuid())
  vendorId  String
  planId    String
  status    SubscriptionStatus @default(PENDING_PAYMENT)
  amount    Decimal            @db.Decimal(10, 3)
  startsAt  DateTime?
  endsAt    DateTime?
  invoiceId String?            @unique
  note      String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  vendor  Vendor         @relation(fields: [vendorId], references: [id])
  plan    SupplierPlan   @relation(fields: [planId], references: [id])
  invoice MarketInvoice? @relation(fields: [invoiceId], references: [id])

  @@index([vendorId, status])
  @@index([endsAt])
}

/// مستخدمو حساب المورد (المالك وموظفوه) — العدد حسب الباقة
model VendorMember {
  id         String           @id @default(cuid())
  vendorId   String
  customerId String
  role       VendorMemberRole @default(STAFF)
  createdAt  DateTime         @default(now())

  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([vendorId, customerId])
  @@index([customerId])
}

enum RfqStatus {
  NEW
  DISTRIBUTED
  QUOTED
  NEGOTIATING
  AWARDED
  CLOSED
  CANCELLED
}

/// طلب عرض سعر (RFQ-000001). يمثل أيضًا الـ Lead في لوحة الإدارة
model Rfq {
  id               String    @id @default(cuid())
  code             String    @unique
  customerId       String
  companyName      String
  contactName      String
  phone            String
  email            String?
  city             String?
  location         String?
  categoryId       String?
  /// عنوان الاحتياج (أول بند أو وصف عام)
  title            String
  /// الطلب من صفحة منتج أو مورد محدد
  productId        String?
  directVendorId   String?
  budget           Decimal?  @db.Decimal(12, 3)
  neededBy         DateTime?
  notes            String?
  /// صور وملفات: [{ url, name, kind }]
  attachments      Json      @default("[]")
  status           RfqStatus @default(NEW)
  // ── الـ Lead والصفقة ──
  expectedValue    Decimal?  @db.Decimal(12, 3)
  finalValue       Decimal?  @db.Decimal(12, 3)
  acceptedQuoteId  String?   @unique
  /// نموذج الإيراد وقت الإغلاق: LEAD | COMMISSION | ONLINE_PAYMENT
  revenueModel     String?
  commissionRate   Decimal?  @db.Decimal(6, 3)
  commissionAmount Decimal?  @db.Decimal(12, 3)
  commissionRuleId String?
  /// طلب توصيل مرتبط بعد الترسية (نظام التوصيل)
  orderId          String?
  adminNote        String?
  closedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  customer      Customer         @relation(fields: [customerId], references: [id])
  category      Category?        @relation(fields: [categoryId], references: [id])
  product       Product?         @relation(fields: [productId], references: [id])
  directVendor  Vendor?          @relation("RfqDirectVendor", fields: [directVendorId], references: [id])
  items         RfqItem[]
  recipients    RfqRecipient[]
  quotes        Quote[]          @relation("RfqQuotes")
  acceptedQuote Quote?           @relation("AcceptedQuote", fields: [acceptedQuoteId], references: [id])
  conversations Conversation[]
  reviews       SupplierReview[]
  events        RfqEvent[]

  @@index([status])
  @@index([customerId])
  @@index([categoryId])
  @@index([createdAt])
}

/// بنود الطلب (يدعم طلب احتياج كامل: عدة منتجات في طلب واحد — أساس Procurement)
model RfqItem {
  id        String  @id @default(cuid())
  rfqId     String
  name      String
  quantity  Decimal @db.Decimal(12, 3)
  unit      String  @default("قطعة")
  specs     String?
  brand     String?
  sortOrder Int     @default(0)

  rfq Rfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
}

enum RecipientStatus {
  SENT
  VIEWED
  QUOTED
  DECLINED
}

/// توزيع الطلب على الموردين (تلقائي أو يدوي) + رسوم الـ Lead إن وُجدت
model RfqRecipient {
  id            String          @id @default(cuid())
  rfqId         String
  vendorId      String
  status        RecipientStatus @default(SENT)
  /// AUTO | MANUAL | DIRECT
  source        String          @default("MANUAL")
  leadFee       Decimal         @default(0) @db.Decimal(10, 3)
  /// الفاتورة التي حُمّلت فيها رسوم الـ Lead (إن وُجدت)
  leadInvoiceId String?
  sentAt        DateTime        @default(now())
  viewedAt      DateTime?
  respondedAt   DateTime?
  declineReason String?

  rfq    Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@unique([rfqId, vendorId])
  @@index([vendorId, status])
}

enum QuoteStatus {
  SUBMITTED
  WITHDRAWN
  ACCEPTED
  REJECTED
}

/// عرض سعر من مورد على طلب
model Quote {
  id            String      @id @default(cuid())
  rfqId         String
  vendorId      String
  unitPrice     Decimal     @db.Decimal(12, 3)
  quantity      Decimal     @db.Decimal(12, 3)
  total         Decimal     @db.Decimal(12, 3)
  leadTimeDays  Int?
  warranty      String?
  originCountry String?
  brand         String?
  specs         String?
  paymentTerms  String?
  validUntil    DateTime?
  notes         String?
  fileUrl       String?
  filePublicId  String?
  status        QuoteStatus @default(SUBMITTED)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  rfq        Rfq    @relation("RfqQuotes", fields: [rfqId], references: [id], onDelete: Cascade)
  acceptedBy Rfq?   @relation("AcceptedQuote")
  vendor     Vendor @relation(fields: [vendorId], references: [id])

  @@unique([rfqId, vendorId])
  @@index([vendorId, status])
}

/// سجل أحداث الطلب (الإرسال، العروض، القبول، الإغلاق…)
model RfqEvent {
  id        String   @id @default(cuid())
  rfqId     String
  /// customer | vendor | admin | system
  actorType String
  actorId   String?
  actorName String?
  action    String
  note      String?
  meta      Json?
  createdAt DateTime @default(now())

  rfq Rfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId, createdAt])
}

/// محادثة داخل المنصة بين العميل والمورد على طلب (بدون كشف بيانات التواصل)
model Conversation {
  id             String    @id @default(cuid())
  rfqId          String
  vendorId       String
  lastAt         DateTime  @default(now())
  customerReadAt DateTime?
  vendorReadAt   DateTime?
  createdAt      DateTime  @default(now())

  rfq      Rfq       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor   Vendor    @relation(fields: [vendorId], references: [id])
  messages Message[]

  @@unique([rfqId, vendorId])
  @@index([vendorId, lastAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  /// CUSTOMER | VENDOR | ADMIN
  senderType     String
  senderId       String?
  senderName     String
  body           String
  /// أُخفيت بيانات تواصل من النص قبل الحفظ
  masked         Boolean  @default(false)
  attachments    Json     @default("[]")
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// محرك العمولات: القاعدة الأكثر تحديدًا (تصنيف/مجموعة/باقة/نوع صفقة) هي المطبّقة
model CommissionRule {
  id              String   @id @default(cuid())
  name            String
  /// تنطبق على تصنيف محدد (وأقسامه الفرعية)
  categoryId      String?
  /// أو على مجموعة تصنيفات (spare_parts, machines…)
  commissionGroup String?
  /// باقة المورد (FREE/PRO/BUSINESS) أو فارغ للكل
  planCode        String?
  /// PRODUCT_SALE | RFQ_DEAL | PROCUREMENT أو فارغ للكل
  dealType        String?
  percent         Decimal  @db.Decimal(6, 3)
  minAmount       Decimal? @db.Decimal(12, 3)
  maxAmount       Decimal? @db.Decimal(12, 3)
  priority        Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id])

  @@index([active])
}

enum AdType {
  FEATURED_PRODUCT
  FEATURED_SUPPLIER
  INDUSTRIAL_DEAL
  PRODUCT_OF_WEEK
  SUPPLIER_OF_MONTH
}

enum AdStatus {
  REQUESTED
  PENDING_PAYMENT
  ACTIVE
  PAUSED
  ENDED
  REJECTED
}

/// باقات الإعلانات وأسعارها (قابلة للتعديل من الإدارة)
model AdPackage {
  id           String   @id @default(cuid())
  type         AdType
  name         String
  /// MARKET_HOME | SEARCH_TOP | CATEGORY_TOP | PRODUCT_PAGE
  placement    String   @default("MARKET_HOME")
  price        Decimal  @db.Decimal(10, 3)
  durationDays Int      @default(7)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ads MarketAd[]
}

/// إعلان داخل السوق لمورد أو منتج
model MarketAd {
  id          String   @id @default(cuid())
  type        AdType
  placement   String   @default("MARKET_HOME")
  vendorId    String
  productId   String?
  packageId   String?
  title       String?
  price       Decimal  @default(0) @db.Decimal(10, 3)
  startsAt    DateTime
  endsAt      DateTime
  status      AdStatus @default(REQUESTED)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  invoiceId   String?  @unique
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor  Vendor         @relation(fields: [vendorId], references: [id])
  product Product?       @relation(fields: [productId], references: [id])
  package AdPackage?     @relation(fields: [packageId], references: [id])
  invoice MarketInvoice? @relation(fields: [invoiceId], references: [id])

  @@index([status, placement, startsAt, endsAt])
  @@index([vendorId])
}

enum InvoicePurpose {
  SUBSCRIPTION
  AD
  LEAD_FEE
  COMMISSION
  ORDER
  PROCUREMENT
  OTHER
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

/// فواتير السوق — مستقلة عن مزود الدفع (provider) ليسهل تغييره لاحقًا
model MarketInvoice {
  id               String         @id @default(cuid())
  /// INV-000001
  number           String         @unique
  vendorId         String?
  customerId       String?
  purpose          InvoicePurpose
  description      String
  amount           Decimal        @db.Decimal(12, 3)
  currency         String         @default("JOD")
  status           InvoiceStatus  @default(PENDING)
  /// manual | (مستقبلًا: hyperpay, stripe, …)
  provider         String         @default("manual")
  providerRef      String?
  /// مرجع العنصر (اشتراك/إعلان/طلب…)
  refType          String?
  refId            String?
  dueAt            DateTime?
  paidAt           DateTime?
  note             String?
  /// إثبات الدفع اليدوي (صورة أو PDF للحوالة) يرفعه المورد وتراجعه الإدارة
  proofUrl         String?
  proofPublicId    String?
  proofName        String?
  proofKind        String?
  /// SUBMITTED (بانتظار مراجعة الإدارة) | REJECTED (رُفض ويُطلب إثبات جديد)
  proofStatus      String?
  proofSubmittedAt DateTime?
  /// رقم الحوالة/المرجع وملاحظة الدافع
  payerReference   String?
  payerNote        String?
  /// سبب رفض الإثبات (يظهر للمورد)
  reviewNote       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  vendor       Vendor?             @relation(fields: [vendorId], references: [id])
  subscription VendorSubscription?
  ad           MarketAd?

  @@index([vendorId, status])
  @@index([purpose, status])
  @@index([proofStatus])
  @@index([createdAt])
}

/// تقييم المورد بعد صفقة حقيقية (طلب عرض سعر تمت ترسيته عليه)
model SupplierReview {
  id            String   @id @default(cuid())
  vendorId      String
  customerId    String
  rfqId         String
  quality       Int
  delivery      Int
  commitment    Int
  communication Int
  overall       Int
  comment       String?
  visible       Boolean  @default(true)
  createdAt     DateTime @default(now())

  vendor   Vendor   @relation(fields: [vendorId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  rfq      Rfq      @relation(fields: [rfqId], references: [id])

  @@unique([rfqId, vendorId])
  @@index([vendorId, visible])
}

/// إحصائيات يومية للمورد (مشاهدات الصفحة والمنتجات، الطلبات، العروض)
model VendorDailyStat {
  id            String @id @default(cuid())
  vendorId      String
  /// YYYY-MM-DD بتوقيت عمّان
  day           String
  profileViews  Int    @default(0)
  productViews  Int    @default(0)
  rfqs          Int    @default(0)
  quotes        Int    @default(0)
  adImpressions Int    @default(0)
  adClicks      Int    @default(0)

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, day])
}

// ═════════════ إحصائيات المنصة والتميز والمكافآت ═════════════

/// لقطة إحصائيات شهرية محفوظة (أرشيف دائم لا يُستبدل): الشهر المكتمل يُجمَّد، والشهر الجاري يُحدَّث
model MonthlySnapshot {
  id         String   @id @default(cuid())
  /// YYYY-MM (بتوقيت عمّان)
  period     String   @unique
  /// المؤشرات الرقمية (مبيعات، طلبات، عملاء، إيرادات…)
  metrics    Json
  /// التفاصيل: أكثر الفئات والمنتجات والمناطق والموردين والعملاء، وإيرادات كل قسم
  breakdown  Json
  /// شهر مكتمل (لا يُعاد حسابه إلا بطلب صريح)
  final      Boolean  @default(false)
  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum RecognitionKind {
  SUPPLIER
  CUSTOMER
}

/// التميز الشهري: يختاره الـ Super Admin يدويًا (النظام يقترح فقط)
model Recognition {
  id          String          @id @default(cuid())
  kind        RecognitionKind
  /// YYYY-MM
  period      String
  title       String
  vendorId    String?
  customerId  String?
  /// مؤشرات المرشح وقت الاختيار (للتوثيق في الأرشيف)
  score       Json?
  note        String?
  createdById String?
  createdAt   DateTime        @default(now())
  revokedAt   DateTime?

  vendor   Vendor?   @relation(fields: [vendorId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  rewards  Reward[]

  @@unique([kind, period])
  @@index([period])
}

enum RewardType {
  /// اشتراك مجاني بباقة ومدة
  FREE_SUBSCRIPTION
  /// ظهور مميز في السوق (مورد مميز)
  FEATURED_PLACEMENT
  /// Banner مجاني في الصفحة الرئيسية للسوق (مورد الشهر)
  HOME_BANNER
  /// منتجات إضافية فوق حد الباقة
  EXTRA_PRODUCTS
  /// خصم مؤقت على الاشتراك
  SUBSCRIPTION_DISCOUNT
  /// شارة تميز ظاهرة (Featured Supplier / Customer)
  BADGE
  /// كوبون خصم للعميل
  COUPON
  /// نقاط ولاء (مرحلة لاحقة)
  POINTS
}

enum RewardStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

/// المكافآت الممنوحة — لا تُمنح إلا بقرار الـ Super Admin
model Reward {
  id             String       @id @default(cuid())
  recognitionId  String?
  vendorId       String?
  customerId     String?
  type           RewardType
  title          String
  planId         String?
  durationDays   Int?
  /// قيمة المكافأة حسب النوع: نسبة خصم، عدد منتجات، نقاط
  value          Decimal?     @db.Decimal(12, 3)
  couponId       String?      @unique
  adId           String?      @unique
  subscriptionId String?      @unique
  startsAt       DateTime     @default(now())
  endsAt         DateTime?
  status         RewardStatus @default(ACTIVE)
  note           String?
  createdById    String?
  createdAt      DateTime     @default(now())
  revokedAt      DateTime?

  recognition Recognition? @relation(fields: [recognitionId], references: [id])
  vendor      Vendor?      @relation(fields: [vendorId], references: [id])
  customer    Customer?    @relation(fields: [customerId], references: [id])
  coupon      Coupon?      @relation(fields: [couponId], references: [id])

  @@index([vendorId, status])
  @@index([customerId, status])
  @@index([createdAt])
}

enum CouponType {
  PERCENT
  FIXED
}

/// كوبونات الخصم (عامة أو لعميل محدد) — تُطبَّق عند إتمام طلب المتجر
model Coupon {
  id               String     @id @default(cuid())
  /// بأحرف إنجليزية كبيرة
  code             String     @unique
  name             String
  description      String?
  type             CouponType @default(PERCENT)
  value            Decimal    @db.Decimal(10, 3)
  maxDiscount      Decimal?   @db.Decimal(10, 3)
  minOrder         Decimal?   @db.Decimal(10, 3)
  startsAt         DateTime   @default(now())
  endsAt           DateTime?
  /// إجمالي مرات الاستخدام (فارغ = بدون حد)
  usageLimit       Int?
  perCustomerLimit Int        @default(1)
  usedCount        Int        @default(0)
  /// مقصور على عميل محدد (كوبون العميل المتميز)
  customerId       String?
  /// الفئات/المنتجات المشمولة (فارغ = كل المنتجات)
  categoryIds      String[]   @default([])
  productIds       String[]   @default([])
  active           Boolean    @default(true)
  createdById      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  customer    Customer?          @relation(fields: [customerId], references: [id])
  redemptions CouponRedemption[]
  orders      Order[]
  reward      Reward?

  @@index([customerId])
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  orderId    String   @unique
  customerId String
  discount   Decimal  @db.Decimal(10, 3)
  createdAt  DateTime @default(now())

  coupon   Coupon   @relation(fields: [couponId], references: [id])
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([couponId, customerId])
}

enum LoyaltyAudience {
  CUSTOMER
  SUPPLIER
}

/// مستويات الولاء (جاهزة للتوسع — غير مفعّلة في المرحلة الأولى)
model LoyaltyTier {
  id        String          @id @default(cuid())
  audience  LoyaltyAudience
  code      String
  name      String
  rank      Int
  /// الحد الأدنى للنقاط أو قيمة المشتريات/المبيعات خلال 12 شهرًا للوصول للمستوى
  minPoints Int             @default(0)
  minSpend  Decimal?        @db.Decimal(12, 3)
  /// مزايا المستوى (خصم، شحن مجاني، أولوية…) — تُحدَّد لاحقًا
  benefits  Json            @default("{}")
  active    Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([audience, code])
}

/// سجل نقاط الولاء (مرحلة لاحقة) — كل حركة نقاط بسببها ومرجعها
model LoyaltyPointsLedger {
  id         String   @id @default(cuid())
  customerId String?
  vendorId   String?
  points     Int
  reason     String
  refType    String?
  refId      String?
  createdAt  DateTime @default(now())

  customer Customer? @relation(fields: [customerId], references: [id])
  vendor   Vendor?   @relation(fields: [vendorId], references: [id])

  @@index([customerId])
  @@index([vendorId])
}

/// دفعة من المورد لفرجار مقابل نسبة فرجار المستحقة (تسجيل يدوي — لا توجد بوابة دفع حاليًا)
model FarjarFeePayment {
  id           String        @id @default(cuid())
  vendorId     String
  amount       Decimal       @db.Decimal(12, 3)
  method       PaymentMethod @default(BANK_TRANSFER)
  /// رقم المرجع أو الإيصال
  reference    String?
  note         String?
  paidAt       DateTime      @default(now())
  recordedById String?
  createdAt    DateTime      @default(now())

  vendor      Vendor                @relation(fields: [vendorId], references: [id])
  recordedBy  User?                 @relation("FeePaymentRecordedBy", fields: [recordedById], references: [id])
  allocations FarjarFeeAllocation[]

  @@index([vendorId])
  @@index([paidAt])
}

/// توزيع الدفعة على الطلبات (الأقدم استحقاقًا أولًا)
model FarjarFeeAllocation {
  id            String  @id @default(cuid())
  paymentId     String
  vendorOrderId String
  amount        Decimal @db.Decimal(10, 3)

  payment     FarjarFeePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  vendorOrder VendorOrder      @relation(fields: [vendorOrderId], references: [id])

  @@index([paymentId])
  @@index([vendorOrderId])
}

/**
 * عدّادات عامة بسيطة (مثل عدد زوار الموقع) — تُزاد ذريًا في قاعدة البيانات
 */
model Counter {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}
